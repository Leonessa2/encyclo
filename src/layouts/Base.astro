---
// Dépôt : Leonessa2/encyclo — fichier : src/layouts/Base.astro  (lot 4, 26/11/2026)
//
// Le gabarit de page DU WIKI. Toute la page vient du moteur
// (moteur/gabarits/Page.astro) ; le wiki n'y ajoute que ses morceaux à lui :
//   · « tete »        : le style et le bouton des figures de données ;
//   · « debut-corps » : les dégradés des courbes miniatures (⚠️ reste de
//     veveprice, servi aujourd'hui sur toutes les pages : le retirer changerait
//     le site — au ménage du lot 7).
// Les pages continuent d'importer CE fichier, avec les mêmes propriétés.
import Page from '../../moteur/gabarits/Page.astro';
import Figures from '../components/Figures.astro';
---
<Page {...Astro.props}>
  <Figures slot="tete" />
  <slot />
</Page>
