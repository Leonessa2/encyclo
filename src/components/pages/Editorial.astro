---
// =============================================================================
//  Editorial.astro — LE rendu générique des pages éditoriales (tous sites)
//
//  ⚠️ CE FICHIER VA DANS LE DÉPÔT  Leonessa2/veve-sites , dans
//     src/components/pages/  (chemin exact : src/components/pages/Editorial.astro)
//
//  Étape 3 du constructeur générique. UN composant pour glossary / acronyms /
//  annuaire / history / brands. Les données arrivent déjà filtrées (publie),
//  gatées (publication programmée) et résolues en langue par engine/lib/
//  editorial.mjs ; les compteurs Brands viennent de l'entrepôt. Aucune logique
//  réutilisable ici : le composant ne fait que METTRE EN FORME.
// =============================================================================
import Base from '../../layouts/Base.astro';
import { collection, parseSources } from '../../../engine/lib/contenu.mjs';
import { sectionMeta, languesDeSection } from '../../../moteur/lib/editorial_pages.mjs';
import { t, localize, numberLocale } from '../../../moteur/lib/i18n.mjs';
import { fichesDe, cheminFiche, ancreJalon, ancreTerme, ancresAnnuaire } from '../../../engine/lib/editorial_entries.mjs';
import { siteUrl } from '../../../moteur/lib/manifest.mjs';
import { definedTermSetLd, chronologieLd, itemListLd } from '../../../moteur/lib/seo.mjs';
import { piecesDe, piecesBanniere, srcsetPiece } from '../../../engine/lib/visuels_wiki.mjs';

const { lang, section } = Astro.props;

// Ancre stable d'un jalon : son `id` de Sheet s'il existe, sinon date + titre
// translitteres. Stable = un lien profond ne casse pas au prochain build.
// ⚠️ RÈGLE D'ANCRE IMPORTÉE, PLUS RECOPIÉE (30/07/2026).
// Ce fichier portait sa propre copie, et elle avait DÉJÀ divergé de celle
// d'`editorial_entries.mjs` : `slice(0, 60)` ici, `slice(0, 70)` là-bas. Sans
// conséquence à ce jour — le plus long identifiant de jalon fait 29 caractères,
// mesuré sur les 41 — et parfaitement silencieux le jour où un titre dépasse :
// la fiche pointerait vers une ancre que la page n'émet pas.
// Le commentaire d'`editorial_entries.mjs` annonçait exactement ce risque
// (« si les deux divergent, ces liens pointent dans le vide »). Il avait raison ;
// deux copies suffisent à diverger, il n'en reste plus qu'une.
const ancre = ancreJalon;
const meta = sectionMeta(section, lang);
// ⭐ VOCABULAIRE DE SHEET, LU PAR UN HUMAIN. Les colonnes `precision` et
// `statut` portent un vocabulaire FERMÉ, saisi en français par l'auteur du
// Sheet — et il était rendu TEL QUEL : la page ANGLAISE de la chronologie
// affiche « 2020-10 (mois) » et un badge « recoupe » depuis toujours. Ce n'est
// pas une colonne de langue (pas de `_en`/`_fr`), donc `resolveLang` ne la voit
// pas et aucun contrôle ne pouvait la signaler. Avec ES/IT/DE, le même mot
// français serait sorti sur cinq pages au lieu de deux.
// ⚠️ Repli sur la valeur BRUTE si la clé n'existe pas : une valeur nouvelle dans
//    le Sheet doit s'afficher telle quelle, jamais sous la forme d'une clé i18n.
//    `t()` renvoie la clé quand elle manque — c'est ce qu'on teste.
const libelle = (cle, brut) => { const v = t(lang, cle); return v === cle ? brut : v; };
// Nombre formaté SELON LA LANGUE. ⚠️ « 8486 » en espagnol et en italien est
// CORRECT : ces locales ne groupent qu'à partir de 5 chiffres (8486 -> 8486,
// 18926 -> 18.926). Ne pas « corriger » ce qui n'est pas cassé.
const nf = numberLocale[lang] || 'en-GB';
const nombre = (v) => (Number.isFinite(Number(v)) && String(v).trim() !== '' ? Number(v).toLocaleString(nf) : null);
// `langs` passe a Base : cette section n'est pas publiee dans toutes les langues
// du site (cf. moteur/lib/langues.mjs). Le gabarit n'annoncera donc en hreflang,
// et n'offrira dans le selecteur de langue, que les langues ou la page existe.
// ⚠️ En commentaire JS, pas en {/* */} : un commentaire JSX en tete de gabarit
// sort dans le HTML comme un blanc avant <html>.
const { items } = await collection(section, lang);
// Adresses des entrées qui ont VRAIMENT une fiche : une ligne d'index ne devient
// un lien que si la page existe (cf. le seuil dans editorial_entries.mjs).
// ⚠️ PIÈGE PAYÉ : la carte était indexée par l'OBJET de l'enregistrement — or
// `collection()` est relu ici ET dans `fichesDe`, donc deux instances
// différentes du même contenu. `Map.has(objet)` était toujours faux : aucun
// lien posé, 58 fiches inatteignables, et pas la moindre erreur au build.
// On indexe donc par une CLÉ de contenu, jamais par identité d'objet.
const cleEntree = (x) => String(x.licence ?? x.id ?? x.terme ?? x.nom ?? '').trim();
// Verdict d'unicité calculé sur CETTE liste : le même que celui de l'index,
// qui part de la même `collection(section, lang)`.
const ancreAnnuaire = ancresAnnuaire(items);
const fiches = new Map((await fichesDe(section, lang))
  .map((f) => [cleEntree(f.record), cheminFiche(f.section, f.slug)]));

// --- Tris propres à chaque section -----------------------------------------
const byText = (k) => (a, b) => String(a[k] || '').localeCompare(String(b[k] || ''));
if (section === 'glossary') items.sort(byText('terme'));
if (section === 'acronyms') items.sort(byText('sigle'));
if (section === 'history')  items.sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')));
if (section === 'brands')   items.sort((a, b) => (Number(b.nb_items) || 0) - (Number(a.nb_items) || 0));

// --- Annuaire : regroupé par type, liens sociaux normalisés ----------------
const SOCIAL = {
  twitter: (v) => (/^https?:/.test(v) ? v : `https://twitter.com/${v.replace(/^@/, '')}`),
  instagram: (v) => (/^https?:/.test(v) ? v : `https://instagram.com/${v.replace(/^@/, '')}`),
  youtube: (v) => (/^https?:/.test(v) ? v : `https://youtube.com/${v.replace(/^@/, '')}`),
  tiktok: (v) => (/^https?:/.test(v) ? v : `https://tiktok.com/@${v.replace(/^@/, '')}`),
  facebook: (v) => (/^https?:/.test(v) ? v : `https://facebook.com/${v.replace(/^@/, '')}`),
  reddit: (v) => (/^https?:/.test(v) ? v : `https://reddit.com/${v.replace(/^@/, '')}`),
  discord: (v) => (/^https?:/.test(v) ? v : ''),
  site: (v) => (/^https?:/.test(v) ? v : `https://${v}`),
};
const socialLinks = (rec) => Object.keys(SOCIAL)
  .map((k) => ({ k, v: String(rec[k] || '').trim() }))
  .filter((x) => x.v)
  .map((x) => ({ k: x.k, href: SOCIAL[x.k](x.v) }))
  .filter((x) => x.href);

const annuaireGroups = section === 'annuaire'
  ? [...items.reduce((m, r) => {
      const type = String(r.type || 'autre').trim() || 'autre';
      (m.get(type) || m.set(type, []).get(type)).push(r);
      return m;
    }, new Map())]
  : [];

const crumbs = [
  { name: t(lang, 'home.crumb'), url: localize(lang, '/') },
  { name: meta.title },
];

// -----------------------------------------------------------------------------
//  DONNEES STRUCTUREES — ⭐ la plus grande surface editoriale du reseau
//  n'emettait QUE son fil d'Ariane (constate le 29/07/2026). Des centaines
//  d'entrees parfaitement structurees dans le HTML, et rien qui les declare.
//
//  ⚠️ CHAQUE SECTION RECOIT LE TYPE QUI LUI CORRESPOND, ET AUCUN AUTRE :
//     glossaire et sigles sont des ensembles de TERMES DEFINIS — c'est
//     litteralement le type prevu pour ca ; la chronologie est une liste de
//     jalons DATES ; l'annuaire est une liste. Les marques n'en recoivent pas
//     ici : chaque marque a sa propre fiche, qui declare la sienne
//     (cf. EditorialEntry.astro). Declarer deux fois la meme entite, une fois
//     sur l'index et une fois sur la fiche, brouille ce qu'on veut dire.
//
//  ⚠️ Les ancres : une entree ne recoit une `url` QUE si elle porte vraiment un
//     `id` dans le HTML. Renvoyer vers une ancre qui n'existe pas serait la
//     meme faute que les hreflang vers des pages non construites.
const urlPage = `${siteUrl()}${localize(lang, meta.path)}`;
const ldSection = (() => {
  if (section === 'glossary') {
    return [definedTermSetLd({
      name: meta.title, description: meta.description, url: urlPage,
      termes: items.map((r) => ({
        name: r.terme,
        description: r.definition || r.description,
        // ⚠️ MÊME fonction que l'attribut `id` rendu plus bas. Une donnée
        // structurée qui pointe vers une ancre que la page n'émet pas est une
        // promesse fausse faite à Google.
        url: ancreTerme(r) ? `${urlPage}#${ancreTerme(r)}` : undefined,
      })),
    })];
  }
  if (section === 'acronyms') {
    return [definedTermSetLd({
      name: meta.title, description: meta.description, url: urlPage,
      termes: items.map((r) => ({
        name: r.sigle,
        // ⭐ Pour un sigle, ce que le lecteur cherche d'abord est ce qu'il VEUT
        //    DIRE. La signification passe donc devant la definition longue.
        description: r.signification || r.definition,
        url: ancreTerme(r) ? `${urlPage}#${ancreTerme(r)}` : undefined,
      })),
    })];
  }
  if (section === 'history') {
    return [chronologieLd(items.map((r) => ({
      name: r.titre, date: r.date, description: r.description || r.quoi,
      url: `${urlPage}#${ancre(r)}`,
    })), urlPage)];
  }
  if (section === 'annuaire') {
    return [itemListLd(items.map((r) => ({ name: r.nom })), urlPage)];
  }
  return [];
})();

// =============================================================================
//  MISE EN FORME « COFFRE » v3 (28/11/2026) — styles : theme.css § 6 bis
//  · en-tête de rubrique (icône, nombre d'entrées) ;
//  · glossaire / sigles : groupés par LETTRE, index A–Z, filtre instantané ;
//  · chronologie : groupée par ANNÉE (les jalons passent en h3 sous le h2 de
//    l'année : la hiérarchie reste continue), légende des types ;
//  · annuaire : navigation par catégorie, avatar à initiales ;
//  · marques : visuel d'une pièce (engine/lib/visuels_wiki.mjs), barre de poids.
//  ⚠️ Les ANCRES ne changent pas (ancreTerme, ancreJalon, ancresAnnuaire) :
//  l'accueil, la recherche et les données structurées y renvoient.
// =============================================================================
const slugLettre = (l) => (/[a-z]/i.test(l) ? l.toLowerCase() : 'autres');
const lettreDe = (txt) => { const c = String(txt || '').trim().charAt(0).toUpperCase(); return /[A-Z]/.test(c) ? c : '#'; };
const groupesLettres = (section === 'glossary' || section === 'acronyms')
  ? [...items.reduce((m, r) => {
      const l = lettreDe(section === 'glossary' ? r.terme : r.sigle);
      (m.get(l) || m.set(l, []).get(l)).push(r);
      return m;
    }, new Map())].map(([l, list]) => ({ l, slug: slugLettre(l), list }))
  : [];
const anneeDe = (d) => { const x = /^(\d{4})/.exec(String(d || '')); return x ? x[1] : '—'; };
const groupesAnnees = section === 'history'
  ? [...items.reduce((m, r) => { const y = anneeDe(r.date); (m.get(y) || m.set(y, []).get(y)).push(r); return m; }, new Map())]
  : [];
const TYPES_JALON = ['drop', 'partenariat', 'produit', 'evenement'];
const typesPresents = TYPES_JALON.filter((ty) => items.some((r) => r.type === ty));
const slugType = (ty) => 'type-' + String(ty).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
const initiales = (nom) => String(nom || '?').replace(/[^\p{L}\p{N} ]/gu, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?';
const maxItems = section === 'brands' ? Math.max(1, ...items.map((r) => Number(r.nb_items) || 0)) : 1;
// Bannière ordinateur : l'éventail de pièces (masqué sous 1100 px par theme.css).
const eventail = piecesBanniere(section);
const COULEUR_SEC = { glossary: '#f2c14e', acronyms: '#7db2ff', brands: '#ff8fa3', history: '#ffb38a', annuaire: '#c4a8ff' };

---
<Base lang={lang} path={meta.path} title={meta.title} description={meta.description}
      langs={languesDeSection(section)} crumbs={crumbs} ld={ldSection}>
  <header class="sec-tete" data-sec={section} style={`--c:${COULEUR_SEC[section] || 'var(--teal)'}`}>
    <span class="sec-ico" aria-hidden="true"></span>
    <div>
      <h1>{meta.title}</h1>
      <p class="lead">{meta.description}</p>
    </div>
    <p class="sec-compte">{t(lang, `wiki.count.${section}`, { n: nombre(items.length) })}</p>
    {eventail.length > 0 && (
      <span class="sec-eventail" aria-hidden="true">
        {eventail.map((p) => <img src={p.image} srcset={srcsetPiece(p.image) || undefined} sizes="118px" alt="" width="118" height="156" loading="lazy" decoding="async" />)}
      </span>
    )}
  </header>

  {(section === 'glossary' || section === 'acronyms') && (
    <>
      <div class="sec-outils">
        <label class="acc-label" for="filtre">{t(lang, 'wiki.filterLabel')}</label>
        <input id="filtre" class="searchbox sec-filtre" type="search" autocomplete="off" data-filtre
               placeholder={t(lang, 'wiki.filterPh', { n: nombre(items.length) })} />
        <nav class="sec-lettres" aria-label={t(lang, 'wiki.letters')}>
          {groupesLettres.map((g) => <a href={`#l-${g.slug}`} data-lettre={g.slug}>{g.l}</a>)}
        </nav>
      </div>
      {groupesLettres.map((g) => (
        <section class="sec-groupe" id={`l-${g.slug}`} data-groupe aria-labelledby={`t-${g.slug}`}>
          <h2 class="sec-lettre" id={`t-${g.slug}`}>{g.l}</h2>
          <dl class="glossary">
            {section === 'glossary' && g.list.map((r) => (
              <div class="term" id={ancreTerme(r) || undefined}>
                <dt>{r.terme}{r.categorie && <span class="tag">{r.categorie}</span>}</dt>
                <dd>{r.definition || r.description}</dd>
              </div>
            ))}
            {/* ⚠️ PAS `id={r.sigle}` : 8 sigles sur 65 contiennent une espace.
                `ancreTerme` est la seule fabrique d'ancre — la même que le JSON-LD. */}
            {section === 'acronyms' && g.list.map((r) => (
              <div class="term" id={ancreTerme(r) || undefined}>
                <dt>{r.sigle}{r.signification && <span class="muted"> — {r.signification}</span>}
                  {r.categorie && <span class="tag">{r.categorie}</span>}</dt>
                {r.definition && <dd>{r.definition}</dd>}
              </div>
            ))}
          </dl>
        </section>
      ))}
      <p class="sec-vide" data-vide hidden>{t(lang, 'wiki.noMatch')}</p>
      <script is:inline>
        (function () {
          // Filtre instantané : masque les entrées qui ne contiennent pas le
          // texte (sans accents), puis les lettres devenues vides.
          var champ = document.querySelector('[data-filtre]');
          if (!champ) return;
          var norme = function (s) { return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };
          var groupes = document.querySelectorAll('[data-groupe]');
          var vide = document.querySelector('[data-vide]');
          champ.addEventListener('input', function () {
            var v = norme(champ.value.trim()), total = 0;
            for (var i = 0; i < groupes.length; i++) {
              var termes = groupes[i].querySelectorAll('.term'), vus = 0;
              for (var j = 0; j < termes.length; j++) {
                var ok = !v || norme(termes[j].textContent).indexOf(v) !== -1;
                termes[j].hidden = !ok; if (ok) vus++;
              }
              groupes[i].hidden = vus === 0; total += vus;
              var l = document.querySelector('[data-lettre="' + groupes[i].id.slice(2) + '"]');
              if (l) l.classList.toggle('sec-lettre--vide', vus === 0);
            }
            if (vide) vide.hidden = total !== 0;
          });
        })();
      </script>
    </>
  )}

  {section === 'annuaire' && (
    <nav class="sec-lettres sec-types" aria-label={t(lang, 'wiki.jumpTo')}>
      {annuaireGroups.map(([type, list]) => <a href={`#${slugType(type)}`}>{type} <small>{list.length}</small></a>)}
    </nav>
  )}
  {section === 'annuaire' && annuaireGroups.map(([type, list]) => (
    <section class="annuaire-group" id={slugType(type)}>
      <h2>{type} <small class="muted">{list.length}</small></h2>
      <div class="grid">
        {/* ⭐ Une ancre par entrée ; `ancreAnnuaire` rend '' pour un nom en
            double, et `undefined` n'émet alors aucun attribut. */}
        {list.map((r) => (
          <div class="item annu" id={ancreAnnuaire(r) || undefined}>
            <span class="annu__avatar" aria-hidden="true">{initiales(r.nom)}</span>
            <div class="annu__corps">
              <div class="n">{r.nom}</div>
              {r.role_specialite && <div class="s">{r.role_specialite}</div>}
              {(r.org || r.pays) && <div class="muted">{[r.org, r.pays].filter(Boolean).join(' · ')}</div>}
              {r.notes && <p class="notes">{r.notes}</p>}
              {socialLinks(r).length > 0 && (
                <div class="socials">
                  {socialLinks(r).map((s) => (
                    <a href={s.href} rel="nofollow noopener" target="_blank">{s.k}</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  {section === 'history' && (
    <div class="sec-outils">
      {typesPresents.length > 0 && (
        <ul class="sec-legende">
          {typesPresents.map((ty) => <li data-type={ty}><i aria-hidden="true"></i>{libelle(`wiki.type.${ty}`, ty)}</li>)}
        </ul>
      )}
      <nav class="sec-lettres" aria-label={t(lang, 'wiki.years')}>
        {groupesAnnees.map(([y]) => <a href={`#an-${y}`}>{y}</a>)}
      </nav>
    </div>
  )}
  {section === 'history' && groupesAnnees.map(([y, list]) => (
    <section class="sec-annee" id={`an-${y}`} aria-labelledby={`ta-${y}`}>
      <h2 class="sec-lettre" id={`ta-${y}`}>{y} <small class="muted">{list.length}</small></h2>
      <ol class="timeline">
        {/* ⭐ Une ancre par jalon. Les titres passent en h3 : ils suivent le h2
            de l'année, la hiérarchie ne saute aucun niveau. */}
        {list.map((r) => (
          <li class="milestone" id={ancre(r)} data-type={r.type || undefined}>
            <div class="when"><a class="lien-ancre" href={`#${ancre(r)}`}>{r.date}</a>{r.precision && r.precision !== 'jour' && <span class="muted"> ({libelle(`history.precision.${r.precision}`, r.precision)})</span>}</div>
            <div class="what">
              <h3>{r.titre}{r.statut && <span class={`badge s-${r.statut}`}>{libelle(`history.statut.${r.statut}`, r.statut)}</span>}</h3>
              {r.resume && <p>{r.resume}</p>}
              {parseSources(r.sources).length > 0 && (
                <p class="sources muted">
                  {t(lang, 'sources.label')}
                  {parseSources(r.sources).map((s, i) => (
                    <>{i > 0 && ' · '}{s.href
                      ? <a href={s.href} rel="nofollow noopener" target="_blank">{s.label}</a>
                      : <span>{s.label}</span>}</>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  {section === 'brands' && (
    <div class="grid marques">
      {items.map((r) => {
        const v = piecesDe(String(r.licence || '').trim(), 1)[0];
        const href = fiches.has(cleEntree(r)) ? localize(lang, fiches.get(cleEntree(r))) : null;
        return (
          <div class="item marque">
            {v
              ? <img class="marque__img" src={v.image} srcset={srcsetPiece(v.image) || undefined} sizes="78px" alt="" width="660" height="870" loading="lazy" decoding="async" />
              : <span class="marque__img marque__init" aria-hidden="true">{initiales(r.nom_affiche || r.licence)}</span>}
            <div class="marque__corps">
              <div class="n">{href ? <a href={href}>{r.nom_affiche || r.licence}</a> : (r.nom_affiche || r.licence)}</div>
              {r.note_editoriale && <div class="s">{r.note_editoriale}</div>}
              <div class="counters">
                {/* La valeur d'abord, l'étiquette ensuite ; `fiche.items`, le mot de la fiche. */}
                <span><b>{nombre(r.nb_items) || '—'}</b> {t(lang, 'fiche.items')}</span>
                <span><b>{r.nb_series || '—'}</b> {t(lang, 'brands.series')}</span>
                {r.premier_drop && (
                  <span class="muted" title={r.date_nature === 'mint' ? t(lang, 'brands.first_mint_hint') : undefined}>
                    <b>{r.premier_drop}</b>{' '}{r.date_nature === 'mint' ? t(lang, 'brands.first_mint') : t(lang, 'brands.first_drop')}
                  </span>
                )}
              </div>
              <span class="marque__poids" aria-hidden="true"><i style={`width:${Math.max(1.5, (Number(r.nb_items) || 0) / maxItems * 100).toFixed(1)}%`}></i></span>
            </div>
          </div>
        );
      })}
    </div>
  )}
</Base>
